ANTHROPIC_API_KEY=your_anthropic_key_here
LINKDAPI_KEY=your_linkdapi_key_here
USE_MOCKS=true

# --- Database (Postgres) — REQUIRED ---
# DATABASE_URL: runtime connection. In prod this is the Supabase pgBouncer POOLER endpoint
#   (port 6543, transaction mode) — the app sets prepare_threshold=None so transaction-mode
#   pooling is safe. Locally it's your Postgres (e.g. the bundled docker-compose db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathfinder
# ALEMBIC_DATABASE_URL: migration connection for `alembic upgrade head`. In prod this is the
#   Supabase DIRECT endpoint (port 5432) — transactional DDL + prepared statements need a real
#   session the pooler can't give. Locally it can equal DATABASE_URL (single Postgres).
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathfinder
# DB_POOL_MIN / DB_POOL_MAX: connection-pool sizing (db.py). Budget Supabase's backend cap
#   (~60 on small tiers) across 2 web replicas + 1 worker. Optional; defaults 1 / 5.
# DB_POOL_MIN=1
# DB_POOL_MAX=5

# --- Redis (lib/redis_client.py) — OPTIONAL, distributed coordination state ---
# Shares the per-IP rate limiter, the rolling spend cache, and the Sonnet concurrency
# governor across web replicas so >1 replica limits correctly. UNSET => everything runs
# in-process (the single-worker path) and local dev needs no Redis. In prod this is the
# Railway-injected REDIS_URL. Local: the bundled docker-compose redis service.
# REDIS_URL=redis://localhost:6379/0
# REDIS_RETRY_COOLDOWN_SEC: after a Redis error, skip Redis (fall back in-process) for this
#   many seconds before probing again — bounds the blast radius of a Redis outage. Default 10.
# REDIS_RETRY_COOLDOWN_SEC=10

# Sonnet rate-limit governor (lib/anthropic_client.py). Optional — code defaults shown.
# SONNET_MAX_CONCURRENCY: GLOBAL max in-flight Sonnet calls across ALL replicas (Redis-backed
#   when REDIS_URL is set; per-process otherwise). Lower = safer under concurrent /run load
#   (sustained input stays under the 30k/min cap at ~4); higher = snappier single runs. Default 6.
SONNET_MAX_CONCURRENCY=6
# SONNET_SLOT_TTL_SEC: how long a held Redis slot lives before it's reclaimed as abandoned
#   (crash-safety). Keep >= ANTHROPIC_TIMEOUT_SEC so a live holder is never reclaimed. Default 200.
# SONNET_SLOT_TTL_SEC=200
# SONNET_POLL_SEC / SONNET_MAX_WAIT_SEC: Redis slot acquire poll interval / max wait before
#   proceeding un-slotted (SDK backoff is the net). Defaults 0.1 / 120.
# SONNET_POLL_SEC=0.1
# SONNET_MAX_WAIT_SEC=120
# ANTHROPIC_MAX_RETRIES: SDK 429/5xx retry ceiling (exponential backoff honoring Retry-After).
ANTHROPIC_MAX_RETRIES=8
# ANTHROPIC_TIMEOUT_SEC: per-request timeout on the shared client (SDK default is a loose 600s).
#   Bounds a genuine API hang. Keep ABOVE the longest call (the Opus roadmap, ~1-2 min) or those
#   get cut + retried. Default 180.
ANTHROPIC_TIMEOUT_SEC=180

# --- Reliability (Day 4 hardening) — all optional, code defaults shown ---
# LINKD_MAX_RETRIES: retries on TRANSIENT LinkdAPI failures (429/5xx/network) — never on a 404
#   (missing/private profile, which maps to a friendly message). Default 2.
LINKD_MAX_RETRIES=2
# DDG_QUERY_TIMEOUT_SEC: per-query timeout for the worker's DDG scrapes — DDGS can hang for
#   minutes when rate-limited; on timeout the query degrades to an empty result. Worker-side. Default 20.
DDG_QUERY_TIMEOUT_SEC=20
# SERVE_MAX_AGE_HOURS: don't serve internship rows the worker hasn't re-validated within this
#   window. Keep comfortably ABOVE the real worker cadence (~6h). Default 48.
SERVE_MAX_AGE_HOURS=48
# SERVE_MAX_AGE_FALLBACK_HOURS: if a national bucket is empty at the tight window (worker lagged),
#   serving falls back to this looser window for that bucket rather than show nothing. Default 96.
SERVE_MAX_AGE_FALLBACK_HOURS=96

# Voyage AI embeddings (lib/embeddings.py) — powers ingestion-time listing embeddings +
# the request-time profile embedding used to cosine-rank candidates before the slim Sonnet
# SELECT. OPTIONAL: when VOYAGE_API_KEY is absent, serving falls back to the non-ranked
# path (Sonnet SELECT over the unranked pool) and the worker stores parsed_json without an
# embedding — nothing breaks, ranking is just skipped.
VOYAGE_API_KEY=your_voyage_key_here
# EMBED_MODEL: Voyage model id. Changing this orphans existing stored embeddings (they
# only cosine-match the same model+dim) — reset with: UPDATE listing_store SET parsed_at=NULL.
# EMBED_MODEL=voyage-3.5
# WORKER_PARSE_CONCURRENCY: max in-flight Haiku listing-parse calls in the worker's parse
# pass (Haiku is ungated by sonnet_sem). Worker-only; default 8.
# WORKER_PARSE_CONCURRENCY=8

# --- Cost protection (lib/guard.py) — per-IP rate limiting + spend-cap kill switch ---
# Redis-backed (shared across replicas) when REDIS_URL is set; falls back to IN-PROCESS /
# per-replica when it isn't. Gates the LLM-firing routes (/run, /analyze*, /profile*,
# /internships*, /connections/*). All optional; code defaults shown. Defaults are sized so a
# normal session never trips.
# RATE_LIMIT_PER_MIN: max gated requests per IP per window. Default 30.
RATE_LIMIT_PER_MIN=30
# RATE_LIMIT_CONCURRENT: max simultaneous in-flight gated requests per IP. Default 4.
RATE_LIMIT_CONCURRENT=4
# RATE_LIMIT_WINDOW_SEC: sliding-window length for the per-min cap. Default 60.
RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_INFLIGHT_TTL_SEC: max lifetime of an in-flight slot in the Redis concurrency set
#   (crash-safety — a crashed replica's slots self-expire). Keep above the longest gated
#   request. Redis path only. Default 120.
# RATE_LIMIT_INFLIGHT_TTL_SEC=120
# SPEND_CAP_USD_DAILY: auto-halt gated routes (503) once rolling-window Claude spend
#   reaches this many USD. 0 = disabled. Code default 0; set a real ceiling before deploy.
SPEND_CAP_USD_DAILY=25
# SPEND_CAP_WINDOW_SEC: rolling window the spend cap measures over. Default 86400 (24h).
SPEND_CAP_WINDOW_SEC=86400
# SPEND_CACHE_TTL_SEC: how often the spend SUM is recomputed (not a per-request DB hit). Default 30.
SPEND_CACHE_TTL_SEC=30
# WORKER_SPEND_CAP_USD_DAILY: the ingestion worker's OWN spend cap (worker/ingest.py). The
#   parse pass's Haiku calls are tagged 'worker:ingest', which the user-facing SPEND_CAP above
#   EXCLUDES — so ingestion can never trip the user kill switch. This bucket bounds ingestion
#   independently: the parse pass stops (leaving rows for next run) once worker spend over
#   WORKER_SPEND_CAP_WINDOW_SEC reaches the cap. 0 = disabled. Code default 0; ingestion is
#   cheap (Haiku) so a few dollars/day is a generous guardrail well above real usage.
WORKER_SPEND_CAP_USD_DAILY=5
# WORKER_SPEND_CAP_WINDOW_SEC: rolling window the worker cap measures over. Default 86400 (24h).
WORKER_SPEND_CAP_WINDOW_SEC=86400
# ADMIN_TOKEN: shared secret for POST /admin/killswitch + GET /admin/status (X-Admin-Token
#   header). UNSET => admin endpoints 403 (fail closed). Set this to enable the manual switch.
ADMIN_TOKEN=your_admin_token_here

# --- Auth + per-user quotas (lib/auth.py) — OPTIONAL, the launch gate ---
# Supabase magic-link auth, verified locally + statelessly. Auth turns ON when EITHER
# SUPABASE_URL or SUPABASE_JWT_SECRET is set; with NEITHER, auth is DISABLED (every route
# stays anonymous/open — local dev + current flow unchanged). Zero code change to go live.
#
# SUPABASE_URL: the project URL (Supabase dashboard > Project Settings > API). This is the
#   switch to use for any modern project — user SESSION tokens are signed with ASYMMETRIC
#   ES256 keys (keyed by `kid`), verified against the project JWKS
#   ({SUPABASE_URL}/auth/v1/.well-known/jwks.json). Backend-only.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWKS_TIMEOUT_SEC: JWKS fetch timeout (default 10).
# SUPABASE_JWKS_TIMEOUT_SEC=10
#
# SUPABASE_JWT_SECRET: the legacy HS256 shared secret (dashboard > API > JWT Settings).
#   FALLBACK ONLY — it verifies the anon/service API keys (which are HS256) but NOT the
#   ES256 user tokens, so it alone cannot authenticate real logins on a modern project.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_ALG: HS256-path signing algorithm (default HS256). ES256/RS256 go via JWKS.
# SUPABASE_JWT_ALG=HS256
# SUPABASE_JWT_AUD: expected audience claim (default 'authenticated').
# SUPABASE_JWT_AUD=authenticated
#
# SUPABASE_SERVICE_ROLE_KEY: admin-scoped key (dashboard > API > service_role). Used ONLY by
#   the account-deletion path (DELETE /account, lib/supabase_admin.py) to hard-delete the
#   Supabase AUTH user. Backend-ONLY — NEVER expose to the browser. UNSET => deletion still
#   erases all app-side data (users/usage_counters, cost_events anonymized) but leaves the
#   auth user for manual cleanup. Set it in prod for a complete one-click account delete.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ADMIN_TIMEOUT_SEC=10
# Per-user daily quotas (UTC day) — 429 over the cap. Analyses are Opus-heavy → tighter.
# QUOTA_MATCHER_PER_DAY: results-page reveals (POST /analyze/batch) per day. Default 20.
# QUOTA_MATCHER_PER_DAY=20
# QUOTA_ANALYSIS_PER_DAY: full /analyze (Opus Phase 3) runs per day. Default 5.
# QUOTA_ANALYSIS_PER_DAY=5

# --- Cloudflare Turnstile (lib/turnstile.py) — OPTIONAL bot protection ---
# UNSET => verify_turnstile is a no-op (every request passes). Set the secret (prod) and the
# expensive routes require a valid X-Turnstile-Token header. Backend-only (the SITE key is
# the client-side one). Network errors to siteverify FAIL OPEN; a definitive reject => 403.
# TURNSTILE_SECRET=
# TURNSTILE_TIMEOUT_SEC=5

# --- Deployment / observability — OPTIONAL (prod) ---
# CORS_ORIGINS: comma-separated browser origins allowed to call the API. Defaults to
#   http://localhost:3000 (dev). MUST be set to the deployed frontend origin before launch,
#   e.g. https://app.yourdomain.com (add a staging origin too if applicable).
# CORS_ORIGINS=http://localhost:3000
# SENTRY_DSN: when set, errors + traces report to Sentry (lib in main.py). Unset => no-op.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE: fraction of requests traced (default 0.1).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT: tag for Sentry events (e.g. 'staging' | 'production'). Default 'production'.
# ENVIRONMENT=production
# PORT: web server port. Railway/most PaaS inject this; the start command binds $PORT.
# PORT=8000
