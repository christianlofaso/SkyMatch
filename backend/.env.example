ANTHROPIC_API_KEY=your_anthropic_key_here
LINKDAPI_KEY=your_linkdapi_key_here
USE_MOCKS=true

# --- Database (Postgres) — REQUIRED ---
# DATABASE_URL: runtime connection. In prod this is the Supabase pgBouncer POOLER endpoint
#   (port 6543, transaction mode) — the app sets prepare_threshold=None so transaction-mode
#   pooling is safe. Locally it's your Postgres (e.g. the bundled docker-compose db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathfinder
# ALEMBIC_DATABASE_URL: migration connection for `alembic upgrade head`. In prod this is the
#   Supabase DIRECT endpoint (port 5432) — transactional DDL + prepared statements need a real
#   session the pooler can't give. Locally it can equal DATABASE_URL (single Postgres).
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathfinder
# DB_POOL_MIN / DB_POOL_MAX: connection-pool sizing (db.py). Budget Supabase's backend cap
#   (~60 on small tiers) across 2 web replicas + 1 worker. Optional; defaults 1 / 5.
# DB_POOL_MIN=1
# DB_POOL_MAX=5

# Sonnet rate-limit governor (lib/anthropic_client.py). Optional — code defaults shown.
# SONNET_MAX_CONCURRENCY: max in-flight Sonnet calls process-wide. Lower = safer under
#   concurrent /run load (sustained input stays under the 30k/min cap at ~4); higher =
#   snappier single runs. Default 6.
SONNET_MAX_CONCURRENCY=6
# ANTHROPIC_MAX_RETRIES: SDK 429/5xx retry ceiling (exponential backoff honoring Retry-After).
ANTHROPIC_MAX_RETRIES=8
# ANTHROPIC_TIMEOUT_SEC: per-request timeout on the shared client (SDK default is a loose 600s).
#   Bounds a genuine API hang. Keep ABOVE the longest call (the Opus roadmap, ~1-2 min) or those
#   get cut + retried. Default 180.
ANTHROPIC_TIMEOUT_SEC=180

# --- Reliability (Day 4 hardening) — all optional, code defaults shown ---
# LINKD_MAX_RETRIES: retries on TRANSIENT LinkdAPI failures (429/5xx/network) — never on a 404
#   (missing/private profile, which maps to a friendly message). Default 2.
LINKD_MAX_RETRIES=2
# DDG_QUERY_TIMEOUT_SEC: per-query timeout for the worker's DDG scrapes — DDGS can hang for
#   minutes when rate-limited; on timeout the query degrades to an empty result. Worker-side. Default 20.
DDG_QUERY_TIMEOUT_SEC=20
# SERVE_MAX_AGE_HOURS: don't serve internship rows the worker hasn't re-validated within this
#   window. Keep comfortably ABOVE the real worker cadence (~6h). Default 48.
SERVE_MAX_AGE_HOURS=48
# SERVE_MAX_AGE_FALLBACK_HOURS: if a national bucket is empty at the tight window (worker lagged),
#   serving falls back to this looser window for that bucket rather than show nothing. Default 96.
SERVE_MAX_AGE_FALLBACK_HOURS=96

# Voyage AI embeddings (lib/embeddings.py) — powers ingestion-time listing embeddings +
# the request-time profile embedding used to cosine-rank candidates before the slim Sonnet
# SELECT. OPTIONAL: when VOYAGE_API_KEY is absent, serving falls back to the non-ranked
# path (Sonnet SELECT over the unranked pool) and the worker stores parsed_json without an
# embedding — nothing breaks, ranking is just skipped.
VOYAGE_API_KEY=your_voyage_key_here
# EMBED_MODEL: Voyage model id. Changing this orphans existing stored embeddings (they
# only cosine-match the same model+dim) — reset with: UPDATE listing_store SET parsed_at=NULL.
# EMBED_MODEL=voyage-3.5
# WORKER_PARSE_CONCURRENCY: max in-flight Haiku listing-parse calls in the worker's parse
# pass (Haiku is ungated by sonnet_sem). Worker-only; default 8.
# WORKER_PARSE_CONCURRENCY=8

# --- Cost protection (lib/guard.py) — per-IP rate limiting + spend-cap kill switch ---
# IN-PROCESS / SINGLE-WORKER ONLY (like SONNET_MAX_CONCURRENCY). Gates the LLM-firing
# routes (/run, /analyze*, /profile*, /internships*, /connections/*). All optional; code
# defaults shown. Defaults are sized so a normal session never trips.
# RATE_LIMIT_PER_MIN: max gated requests per IP per window. Default 30.
RATE_LIMIT_PER_MIN=30
# RATE_LIMIT_CONCURRENT: max simultaneous in-flight gated requests per IP. Default 4.
RATE_LIMIT_CONCURRENT=4
# RATE_LIMIT_WINDOW_SEC: sliding-window length for the per-min cap. Default 60.
RATE_LIMIT_WINDOW_SEC=60
# SPEND_CAP_USD_DAILY: auto-halt gated routes (503) once rolling-window Claude spend
#   reaches this many USD. 0 = disabled. Code default 0; set a real ceiling before deploy.
SPEND_CAP_USD_DAILY=25
# SPEND_CAP_WINDOW_SEC: rolling window the spend cap measures over. Default 86400 (24h).
SPEND_CAP_WINDOW_SEC=86400
# SPEND_CACHE_TTL_SEC: how often the spend SUM is recomputed (not a per-request DB hit). Default 30.
SPEND_CACHE_TTL_SEC=30
# ADMIN_TOKEN: shared secret for POST /admin/killswitch + GET /admin/status (X-Admin-Token
#   header). UNSET => admin endpoints 403 (fail closed). Set this to enable the manual switch.
ADMIN_TOKEN=your_admin_token_here
