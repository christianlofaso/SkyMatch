# dependencies
node_modules/
frontend/node_modules/

# nextjs — .next-* covers the isolated dist dirs used to run a second dev server
# alongside :3000 (NEXT_DIST_DIR=.next-fixed etc., see docs/audit-fixes.md)
.next/
frontend/.next/
.next-*/
frontend/.next-*/

# env files
.env
.env.local

# run logs (uvicorn / worker / eval passes) — regenerated on every run, never source
*.log

# local Ollama models + runtime (multi-GB, not part of the app)
ollama/

# python
venv/
__pycache__/

# local SQLite cache (binary; regenerated by the worker) + WAL sidecars
backend/skymatch_cache.db
*.db-wal
*.db-shm

# typescript incremental build cache
*.tsbuildinfo

# scratch / experiments
scratch/
backend/scratch/

# UI design explorations (options a-n, mockups, screenshots). Kept out of the default
# branch so it reads as the application it is rather than a mockup dump; the full
# lineage lives on the `design-history` branch and stays on disk locally.
design-explorations/

# claude code workspace settings (local)
.claude/

# misc
.DS_Store
